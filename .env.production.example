# Production environment variables — set these in Railway's dashboard
# (Settings -> Variables), never commit actual values to git.

# Postgres — Railway provisions this automatically if you add a Postgres
# plugin to the project; it injects DATABASE_URL for you.
DATABASE_URL=

# Auth
JWT_SECRET=                    # generate with: openssl rand -base64 48

# QuickBooks (from your Intuit app's Keys & Credentials page — PRODUCTION
# keys once you're past sandbox testing, not the sandbox ones)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=              # e.g. https://api.yourdomain.com/quickbooks/callback

# CORS — must exactly match your deployed frontend's origin, no trailing slash
FRONTEND_ORIGIN=                # e.g. https://app.yourdomain.com

# AI-generated care plans (Care Plan tab) — from console.anthropic.com.
# Without this set, POST /care-plans/generate returns a 503 explaining why.
ANTHROPIC_API_KEY=

PORT=3000
